{
  "name": "wine-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/init-db.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "postinstall": "node -e \"const fs=require('fs'),f='package-lock.json';if(fs.existsSync(f)){fs.writeFileSync(f,fs.readFileSync(f,'utf8').replaceAll('https://socket-firewall-registry.corporate.intercom.io/npm/','https://registry.npmjs.org/'))}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@neondatabase/serverless": "^1.0.1",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "nanoid": "3.3.16",
    "caniuse-lite": "1.0.30001806",
    "baseline-browser-mapping": "2.11.10"
  }
}
