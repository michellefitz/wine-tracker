# Neon Postgres connection string (pooled URL from the Neon dashboard).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Anthropic API key — used server-side only, for reading wine labels from photos.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the model used for label reading.
# ANTHROPIC_MODEL="claude-opus-5"

# Google Gemini API key — used server-side only, for generating studio shots
# from a photo you took. Optional: without it the rest of the app works and the
# "Make a studio shot" button says it isn't set up. Get one from Google AI Studio.
GEMINI_API_KEY="AIza..."

# Optional: override the model used for studio shots.
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# The passcode you type once on your phone to unlock the app.
APP_PASSCODE="choose-something-memorable"

# Random secret used to sign the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
