# Neon Postgres connection string (pooled URL from the Neon dashboard).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Anthropic API key — used server-side only, for reading wine labels from photos.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the model used for label reading.
# ANTHROPIC_MODEL="claude-opus-5"

# The passcode you type once on your phone to unlock the app.
APP_PASSCODE="choose-something-memorable"

# Random secret used to sign the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
